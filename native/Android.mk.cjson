# 构建 libcjson.so —— 动态依赖宿主 libluajava.so（与 AndroLua 官方 cjson.so 同构）
#
# 背景（BUILD.md 坑16 / CHANGES-20261109-v15-cjson.md）：cjson.so 若静态链
# lua 源码（LOCAL_STATIC_LIBRARIES := lua）会把整份 lua VM 链进 cjson.so，
# 与宿主 libluajava.so 内的 lua 形成双 VM 实例，操作同一 lua_State 却走两套
# GC/内部实现 → 解码场景 GC 堆损坏 SIGSEGV。正确结构（AndroLua 官方预编译
# 同款）：cjson.so 不含任何 lua 实现，DT_NEEDED 登记宿主 libluajava.so，
# 全部 lua 符号运行时由宿主解析——单 VM 实例。
#
# 链接输入直接使用 APK 打包的宿主 so（app/src/main/jniLibs/<abi>/libluajava.so，
# 与 APK 内逐字节一致）。历史上的 native/prebuilt-luajava/ 冗余副本已于
# v1.5.1 删除——单一事实来源，杜绝宿主 so 更新后副本失配的隐患。
#
# 用法（NDK r27c，与 libluajava.so 同代工具链）：
#   cd native
#   <NDK r27c>/ndk-build NDK_PROJECT_PATH=. \
#     APP_BUILD_SCRIPT=Android.mk.cjson NDK_APPLICATION_MK=Application.mk.cjson \
#     NDK_OUT=/tmp/cjson-obj NDK_LIBS_OUT=/tmp/cjson-libs
# 之后把 /tmp/cjson-libs/<abi>/libcjson.so 复制进 app/src/main/jniLibs/<abi>/。

LOCAL_PATH := $(call my-dir)

include $(CLEAR_VARS)
LOCAL_CFLAGS += -std=c99
LOCAL_C_INCLUDES += $(LOCAL_PATH)/lua
LOCAL_MODULE := cjson
LOCAL_SRC_FILES := \
        cjson/lua_cjson.c \
        cjson/fpconv.c \
        cjson/strbuf.c
LOCAL_LDFLAGS += -L$(LOCAL_PATH)/../app/src/main/jniLibs/$(TARGET_ARCH_ABI)
LOCAL_LDFLAGS += -lluajava
LOCAL_LDLIBS += -llog -lm
include $(BUILD_SHARED_LIBRARY)
