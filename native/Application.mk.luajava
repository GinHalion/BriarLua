APP_ABI := arm64-v8a armeabi-v7a
APP_PLATFORM := android-21
APP_STL := none
APP_OPTIM := release
APP_ALLOW_MISSING_DEPS := true
# v1.11.1 fix: 16KB page alignment required on 16KB-page devices
# (full Application.mk already had it; these single-build entries lacked it,
#  producing 4KB-aligned host .so -> app crashes at load on 16KB devices).
APP_LDFLAGS := -Wl,-z,max-page-size=16384
